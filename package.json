{
  "name": "opwebrtc",
  "version": "0.1.0",
  "private": true,
  "description": "Librería WebRTC agnóstica a frameworks para videollamadas personalizables, seguras y ligeras",
  "workspaces": [
    "packages/*",
    "demo"
  ],
  "scripts": {
    "build": "npm run build -w @opwebrtc/core",
    "dev:core": "npm run dev -w @opwebrtc/core",
    "dev:signaling": "npm run dev -w @opwebrtc/signaling-server",
    "dev:demo": "npm run dev -w demo"
  },
  "license": "MIT"
}
