{
  "name": "@opwebrtc/core",
  "version": "0.1.0",
  "description": "Núcleo WebRTC agnóstico a frameworks: lógica de videollamada P2P, eventos y auditoría. Sin UI.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./blur": {
      "types": "./dist/blur.d.ts",
      "import": "./dist/blur.js",
      "require": "./dist/blur.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "author": "Tilson Fernandez <fernandeztilson@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TilsonF/opWebRTC.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/TilsonF/opWebRTC#readme",
  "bugs": "https://github.com/TilsonF/opWebRTC/issues",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "tsup"
  },
  "keywords": [
    "webrtc",
    "video",
    "p2p",
    "videollamada",
    "framework-agnostic"
  ],
  "dependencies": {
    "eventemitter3": "^5.0.1"
  },
  "peerDependencies": {
    "@mediapipe/tasks-vision": "^0.10.0"
  },
  "peerDependenciesMeta": {
    "@mediapipe/tasks-vision": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "^0.10.18",
    "tsup": "^8.3.5",
    "typescript": "^7.0.2"
  },
  "license": "MIT"
}
