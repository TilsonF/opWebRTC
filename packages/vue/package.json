{
  "name": "@opwebrtc/vue",
  "version": "0.1.0",
  "description": "Composable Vue (useCall) para @opwebrtc/core: videollamada P2P reactiva.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "author": "Tilson Fernandez <fernandeztilson@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TilsonF/opWebRTC.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/TilsonF/opWebRTC#readme",
  "bugs": "https://github.com/TilsonF/opWebRTC/issues",
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["webrtc", "vue", "composable", "videollamada", "p2p"],
  "peerDependencies": {
    "@opwebrtc/core": "^0.1.0",
    "vue": ">=3"
  },
  "devDependencies": {
    "@opwebrtc/core": "*",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vue": "^3.5.13"
  },
  "license": "MIT"
}
