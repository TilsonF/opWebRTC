# Configuración del servidor de señalización opWebRTC

# Puerto del WebSocket + HTTP (por defecto 8080)
PORT=8080

# ── Auth de sala ────────────────────────────────────────────────
# Desactivada por defecto. true para exigir token a quien se una.
AUTH_ENABLED=false
AUTH_TOKEN=cambia-esto-por-un-secreto

# ── TURN efímero (coturn) ───────────────────────────────────────
# El endpoint GET /ice firma credenciales temporales con este secreto.
# Debe coincidir con `static-auth-secret` en turnserver.conf.
TURN_SECRET=
# URLs del TURN, separadas por coma. Ej: turn:tu-dominio:3478,turns:tu-dominio:5349
TURN_URLS=
# Vigencia de las credenciales en segundos (por defecto 3600).
TURN_TTL=3600
# STUN público por defecto (puedes apuntar al tuyo).
STUN_URL=stun:stun.l.google.com:19302

# ── WSS / TLS (opcional) ────────────────────────────────────────
# Si defines ambos, el servidor arranca como wss:// + https.
# Para local: mkcert localhost  ->  apunta a los .pem generados.
TLS_CERT=
TLS_KEY=
