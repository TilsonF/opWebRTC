# Configuración del servidor de señalización opWebRTC

# Puerto del WebSocket (por defecto 8080)
PORT=8080

# Auth de sala. Desactivada por defecto (desarrollo local).
# Ponla en true para exigir token a quien se una.
AUTH_ENABLED=false

# Token compartido que el cliente debe enviar en new Call({ token }).
# Solo se valida si AUTH_ENABLED=true.
AUTH_TOKEN=cambia-esto-por-un-secreto
